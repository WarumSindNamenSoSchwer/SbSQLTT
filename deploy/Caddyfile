# Globale Optionen: kein Zugriffsprotokoll (keine log-Direktive in den Site-Blöcken).
# Server- und Fehlermeldungen gehen in eine Datei, IP-Adressen werden gekürzt,
# täglich um 00:00 rotiert und nach 13 Tagen gelöscht (aktuelle Datei + 13 = höchstens 14 Tage).
{
	log default {
		output file /data/logs/caddy.log {
			roll_at 00:00
			roll_keep_for 312h
			roll_keep 20
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For ip_mask 24 48
			remote delete
			remote_ip ip_mask 24 48
			wrap json
		}
	}
}

# Zwei Adressen (30.10.2026), ein statischer Build in /srv/site:
# - https://www.tabulasql.de: Website (Startseite, Datensätze, Impressum, Datenschutz, Kontakt)
# - https://app.tabulasql.de: App (Lernen, Klassen, Anmelden, Beitreten, Profil, Quiz) und Konten-API.
#   Das Anmelde-Cookie gilt nur hier, die Website bekommt es nie.
# App-Adressen auf www (alte Links, gedruckte QR-Codes) leitet der Browser um (src/app.html), weil er
# dabei den Fortschritt ohne Konto mitnimmt. Website-Adressen auf app leitet Caddy um (unten).
# Ohne www leitet auf www um.
tabulasql.de {
	redir https://www.tabulasql.de{uri} permanent
}

# Sicherheits-Header für alle Antworten (beide Adressen). Keine Skript-Regeln (CSP für Skripte erst
# nach eigenem Test), nur Einbetten in fremde Seiten, Formularziele und Plugins sind ausgeschlossen.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

(static_site) {
	root * /srv/site
	header /sql/* Cache-Control "public, max-age=31536000"
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"

	# Statische Seite. Eigener handle-Block, damit try_files nicht /api/* auf /200.html umschreibt.
	handle {
		try_files {path} {path}.html /200.html
		file_server
	}
}

www.tabulasql.de {
	encode zstd gzip
	import security_headers

	# Kontaktformular-Dienst: MUSS vor einer allgemeinen /api/*-Regel stehen.
	# Caddy prueft handle-Bloecke der Reihe nach; der erste passende gewinnt.
	handle /api/contact {
		reverse_proxy contact:3001 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Die Konten-API gibt es nur auf app.tabulasql.de.
	handle /api/* {
		respond 404
	}

	# Altes Anmelde-Cookie von www (vor dem 30.10.2026) beim nächsten Besuch löschen.
	@oldsession header Cookie *tabula_session=*
	header @oldsession +Set-Cookie "tabula_session=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"

	import static_site
}

app.tabulasql.de {
	encode zstd gzip
	import security_headers

	# Website-Seiten gehören nach www (Links aus der App, Fußzeilen, alte Lesezeichen).
	@website path /datasets /datasets/* /datenschutz /impressum /kontakt /docs /fuer-lehrkraefte
	redir @website https://www.tabulasql.de{uri} permanent

	# Suchmaschinen: eigene Sitemap mit den Lektionen
	rewrite /sitemap.xml /sitemap-app.xml
	rewrite /robots.txt /robots-app.txt

	# Konten-API (compose.backend.yml), freigeschaltet am 25.10.2026, seit 30.10.2026 nur hier.
	# Caddy leitet WebSocket-Upgrades automatisch weiter. Der API-Server prüft Origin (CSRF).
	# X-Real-IP (von Caddy gesetzt, ein mitgeschickter Wert wird überschrieben) dient nur dem
	# Anmeldeschutz im Arbeitsspeicher: Die API bildet daraus ein flüchtiges HMAC-Kennzeichen und
	# speichert oder protokolliert die Adresse nicht (K10, server/src/plugins/ratelimit.ts).
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	import static_site
}
