# Globale Optionen: kein Zugriffsprotokoll (keine log-Direktive in den Site-Blöcken).
# Server- und Fehlermeldungen gehen in eine Datei, IP-Adressen werden gekürzt,
# täglich um 00:00 rotiert und nach 13 Tagen gelöscht (aktuelle Datei + 13 = höchstens 14 Tage).
{
	log default {
		output file /data/logs/caddy.log {
			roll_at 00:00
			roll_keep_for 312h
			roll_keep 20
		}
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>X-Forwarded-For ip_mask 24 48
			remote delete
			remote_ip ip_mask 24 48
			wrap json
		}
	}
}

# Hauptadresse: https://www.tabulasql.de (ohne www leitet dorthin um)
tabulasql.de {
	redir https://www.tabulasql.de{uri} permanent
}

www.tabulasql.de {
	encode zstd gzip

	# Sicherheits-Header für alle Antworten. Keine Skript-Regeln (CSP für Skripte erst nach eigenem
	# Test), nur Einbetten in fremde Seiten, Formularziele und Plugins sind ausgeschlossen.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Kontaktformular-Dienst: MUSS vor einer allgemeinen /api/*-Regel stehen.
	# Caddy prueft handle-Bloecke der Reihe nach; der erste passende gewinnt.
	handle /api/contact {
		reverse_proxy contact:3001 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Konten-API (compose.backend.yml), freigeschaltet am 25.10.2026.
	# Caddy leitet WebSocket-Upgrades automatisch weiter. Der API-Server prüft Origin (CSRF).
	# X-Real-IP (von Caddy gesetzt, ein mitgeschickter Wert wird überschrieben) dient nur dem
	# Anmeldeschutz im Arbeitsspeicher: Die API bildet daraus ein flüchtiges HMAC-Kennzeichen und
	# speichert oder protokolliert die Adresse nicht (K10, server/src/plugins/ratelimit.ts).
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	root * /srv/site
	header /sql/* Cache-Control "public, max-age=31536000"
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"

	# Statische Seite. Eigener handle-Block, damit try_files nicht /api/* auf /200.html umschreibt.
	handle {
		try_files {path} {path}.html /200.html
		file_server
	}
}
